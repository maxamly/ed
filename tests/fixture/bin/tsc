#!/usr/bin/env python3
"""A tiny stand-in for `tsc --noEmit` on the fixture repo.

Catches the breakages edits typically cause: unbalanced brackets, imports of missing modules or
names, duplicate imports, and use of an exported name without importing it.
"""
import os
import re
import sys

ROOTS = ('src', 'app')
EXPORT = re.compile(r'^export\s+(?:async\s+)?(?:function|const|let|class|type|interface)\s+(\w+)', re.M)
EXPORT_LIST = re.compile(r'^export\s*\{([^}]*)\}', re.M)
IMPORT = re.compile(r"^import\s+(?:(\w+)\s*,?\s*)?(?:\{([^}]*)\})?\s*from\s+['\"]([^'\"]+)['\"]", re.M)


def strip(code):
    code = re.sub(r'/\*.*?\*/', lambda m: ' ' * len(m.group()), code, flags=re.S)
    code = re.sub(r'//[^\n]*', '', code)
    return re.sub(r'"(?:\\.|[^"\\\n])*"|\'(?:\\.|[^\'\\\n])*\'|`(?:\\.|[^`\\])*`', '""', code)


def files():
    for root in ROOTS:
        for d, _, fs in os.walk(root):
            for f in fs:
                if f.endswith(('.ts', '.tsx')):
                    yield os.path.join(d, f).replace(os.sep, '/')


def resolve(spec, frm):
    if spec.startswith('@/'):
        base = 'src/' + spec[2:]
    elif spec.startswith('.'):
        base = os.path.normpath(os.path.join(os.path.dirname(frm), spec)).replace(os.sep, '/')
    else:
        return 'external'
    for c in (base + '.ts', base + '.tsx', base + '/index.ts'):
        if os.path.exists(c):
            return c
    return None


def read(p):
    with open(p, encoding='utf-8-sig') as f:
        return f.read().replace('\r\n', '\n')


def main():
    srcs = {p: read(p) for p in files()}
    exports = {}
    for p, s in srcs.items():
        names = set(EXPORT.findall(s))
        for grp in EXPORT_LIST.findall(s):
            names.update(n.split(' as ')[-1].strip() for n in grp.split(',') if n.strip())
        if re.search(r'^export default', s, re.M):
            names.add('default')
        exports[p] = names
    known = {n for ns in exports.values() for n in ns if n != 'default'}
    errors = []

    def err(p, s, pos, code, msg):
        line = s.count('\n', 0, pos) + 1
        errors.append(f'{p}({line},1): error TS{code}: {msg}')

    for p, s in srcs.items():
        code = strip(s)
        stack = []
        for i, ch in enumerate(code):
            if ch in '([{':
                stack.append((ch, i))
            elif ch in ')]}':
                if not stack or '([{'[')]}'.index(ch)] != stack[-1][0]:
                    err(p, s, i, 1128, f"Unexpected '{ch}'.")
                    break
                stack.pop()
        else:
            if stack:
                err(p, s, stack[-1][1], 1005, f"'{')]}'['([{'.index(stack[-1][0])]}' expected.")
        imported = set()
        for m in IMPORT.finditer(s):
            default, named, spec = m.groups()
            target = resolve(spec, p)
            if target is None:
                err(p, s, m.start(), 2307, f"Cannot find module '{spec}'.")
                continue
            names = ([default] if default else []) + [n.strip() for n in (named or '').split(',') if n.strip()]
            for n in names:
                local = n.split(' as ')[-1].strip()
                if local in imported:
                    err(p, s, m.start(), 2300, f"Duplicate identifier '{local}'.")
                imported.add(local)
                if target != 'external':
                    want = 'default' if n == default else n.split(' as ')[0].strip()
                    if want not in exports[target]:
                        err(p, s, m.start(), 2305, f"Module '{spec}' has no exported member '{want}'.")
        body = IMPORT.sub('', code)
        local = set(re.findall(r'\b(?:function|const|let|var|class)\s+(\w+)', body))
        for name in sorted(known - imported - local):
            m = re.search(r'(?<![.\w])' + re.escape(name) + r'\b(?!\s*:)', body)
            if m and not re.search(r'^export\s*\{[^}]*\b' + re.escape(name) + r'\b', s, re.M):
                err(p, s, m.start(), 2304, f"Cannot find name '{name}'.")
    if errors:
        print('\n'.join(errors))
        print(f'\nFound {len(errors)} error(s).')
        return 2
    return 0


if __name__ == '__main__':
    sys.exit(main())
